generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// Base operativa
// ==========================================

model Base {
  id_base       String @id @default(uuid())
  nombre        String
  posicion_base String // JSON: {"lat": -38.71, "lng": -62.26}
  direccion     String

  usuarios          Usuario[]
  solicitudes       Solicitud[]
  stocks            Stock_Base[]
  envios            Envio[]
  historiales_stock Historial_Stock[]
}

// ==========================================
// Usuario (tabla única con rol)
// ==========================================

model Usuario {
  id_usuario    String  @id @default(uuid())
  nombre        String?
  email         String?
  telefono      String?
  rol           String // "SOLICITANTE" | "ADMINISTRADOR" | "REMITENTE"
  contrasena    String?
  estado_cuenta String  @default("PENDIENTE")
  id_base       String? // solo para remitentes

  base                    Base?              @relation(fields: [id_base], references: [id_base])
  solicitudes_creadas     Solicitud[]        @relation("Solicitante")
  solicitudes_gestionadas Solicitud[]        @relation("AdminGestiona")
  historiales_estado      Historial_Estado[]
  historiales_stock       Historial_Stock[]
  notificaciones          Notificacion[]
}

// ==========================================
// Solicitudes
// ==========================================

model Solicitud {
  id_solicitud       String    @id @default(uuid())
  fecha_solicitada   DateTime  @default(now())
  fecha_entrega      DateTime?
  fecha_estimada     DateTime?
  estado             String
  prioridad          String
  ubicacion_destino  String // JSON: {"lat": -38.0, "lng": -62.5}
  motivo_cancelacion String?
  motivo_anulacion   String?
  cantidad_cajas     Int?
  id_usuario         String
  id_admin           String?
  id_base            String?

  solicitante    Usuario             @relation("Solicitante", fields: [id_usuario], references: [id_usuario])
  admin          Usuario?            @relation("AdminGestiona", fields: [id_admin], references: [id_usuario])
  base           Base?               @relation(fields: [id_base], references: [id_base])
  detalles       Detalle_Solicitud[]
  historiales    Historial_Estado[]
  notificaciones Notificacion[]
  envios         Envio[]
}

// ==========================================
// Detalle de solicitud
// ==========================================

model Detalle_Solicitud {
  id_detalle          String @id @default(uuid())
  cantidad_solicitada Int
  cantidad_aprobada   Int?
  id_solicitud        String
  id_producto         String

  solicitud Solicitud @relation(fields: [id_solicitud], references: [id_solicitud], onDelete: Cascade)
  producto  Producto  @relation(fields: [id_producto], references: [id_producto])
}

// ==========================================
// Productos e Inventario
// ==========================================

model Producto {
  id_producto String  @id @default(uuid())
  nombre      String
  descripcion String?
  peso_kg     Float   @default(0)
  categoria   String?

  stocks             Stock_Base[]
  detalles_solicitud Detalle_Solicitud[]
  historiales_stock  Historial_Stock[]
}

model Stock_Base {
  id_stock            String @id @default(uuid())
  cantidad_disponible Int
  cantidad_reservada  Int    @default(0)
  id_base             String
  id_producto         String

  base     Base     @relation(fields: [id_base], references: [id_base])
  producto Producto @relation(fields: [id_producto], references: [id_producto])
}

model Historial_Stock {
  id_historial_stock String   @id @default(uuid())
  cantidad_anterior  Int
  cantidad_nueva     Int
  fecha_hora         DateTime @default(now())
  id_base            String
  id_producto        String
  id_actor           String

  base     Base     @relation(fields: [id_base], references: [id_base])
  producto Producto @relation(fields: [id_producto], references: [id_producto])
  actor    Usuario  @relation(fields: [id_actor], references: [id_usuario])
}

// ==========================================
// Envíos y Contenedores
// ==========================================

model Envio {
  id_envio        String    @id @default(uuid())
  fecha_hora      DateTime?
  estado_envio    String    @default("PROGRAMADO")
  datos_clima     Json?    // Almacena datos de trayectoria calculada (CARP, clima, offsets) como JSON
  entrega_real    DateTime?
  cod_seguimiento String?
  fecha_salida    DateTime?
  id_base         String
  id_solicitud    String

  base         Base         @relation(fields: [id_base], references: [id_base])
  solicitud    Solicitud    @relation(fields: [id_solicitud], references: [id_solicitud])
  contenedores Contenedor[]
}

model Contenedor {
  id_contenedor   String @id @default(uuid())
  tipo_paracaidas String
  peso_max        Float
  id_envio        String

  envio Envio @relation(fields: [id_envio], references: [id_envio], onDelete: Cascade)
}

// ==========================================
// Trazabilidad
// ==========================================

model Historial_Estado {
  id_historial String   @id @default(uuid())
  fecha_hora   DateTime @default(now())
  est_ant      String?
  est_nue      String
  id_solicitud String
  id_usuario   String

  solicitud Solicitud @relation(fields: [id_solicitud], references: [id_solicitud], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [id_usuario], references: [id_usuario])
}

model Notificacion {
  id_notificacion String    @id @default(uuid())
  mensaje         String
  fecha           DateTime  @default(now())
  leida           Boolean   @default(false)
  tipo            String?
  canal_envio     String?
  enviada_at      DateTime?
  id_solicitud    String?
  id_usuario      String

  solicitud Solicitud? @relation(fields: [id_solicitud], references: [id_solicitud], onDelete: Cascade)
  usuario   Usuario    @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
}
