generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// Usuarios y Roles (Herencia) - CU-01 a CU-05
// ==========================================

model Usuario {
  id_usuario    String  @id @default(uuid()) // Será el ID provisto por Clerk (ADR-006)
  contrasena    String? // Opcional ya que la autenticación se delega a Clerk
  estado_cuenta String  @default("PENDIENTE") // PENDIENTE, APROBADA, RECHAZADA

  // Relaciones de herencia (1 a 1)
  solicitante    Solicitante?
  administrador  Administrador?
  remitente      Remitente?

  // Trazabilidad y Notificaciones
  historiales_estado Historial_Estado[]
  historiales_stock  Historial_Stock[]
  notificaciones     Notificacion[]
}

model Solicitante {
  id_solicitante String @id
  nombre         String
  contacto       String

  usuario     Usuario     @relation(fields: [id_solicitante], references: [id_usuario], onDelete: Cascade)
  solicitudes Solicitud[]
}

model Administrador {
  id_admin     String @id
  nombre       String
  usuario      String // Nombre de usuario en el sistema
  permisos_rol String

  cuenta_usuario Usuario     @relation(fields: [id_admin], references: [id_usuario], onDelete: Cascade)
  solicitudes    Solicitud[]
}

model Remitente {
  id_remitente String @id
  id_base      String

  usuario Usuario @relation(fields: [id_remitente], references: [id_usuario], onDelete: Cascade)
  base    Base    @relation(fields: [id_base], references: [id_base])
}

// ==========================================
// Bases operativas (ubicaciones físicas)
// ==========================================

model Base {
  id_base   String @id @default(uuid())
  nombre    String
  latitud   Float
  longitud  Float
  direccion String
  capacidad_pista String

  remitentes        Remitente[]
  stock_bases       Stock_Base[]
  historiales_stock Historial_Stock[]
  solicitudes       Solicitud[]
  envios            Envio[]
}

// ==========================================
// Catálogo e Inventario - CU-17, CU-18
// ==========================================

model Producto {
  id_producto   String  @id @default(uuid())
  nombre        String
  descripcion   String?
  peso_unitario Float
  categoria     String?

  stocks             Stock_Base[]
  detalles_solicitud Detalle_Solicitud[]
  historiales_stock  Historial_Stock[]
}

model Stock_Base {
  id_stock            String @id @default(uuid())
  id_base             String
  id_producto         String
  cantidad_disponible Int
  cantidad_reservada  Int    @default(0)

  base    Base     @relation(fields: [id_base], references: [id_base])
  producto Producto @relation(fields: [id_producto], references: [id_producto])
}

model Historial_Stock {
  id_historial_stock String   @id @default(uuid())
  id_base            String
  id_producto        String
  cantidad_anterior  Int
  cantidad_nueva     Int
  id_actor           String
  fecha_hora         DateTime @default(now())

  base    Base     @relation(fields: [id_base], references: [id_base])
  producto Producto @relation(fields: [id_producto], references: [id_producto])
  actor   Usuario  @relation(fields: [id_actor], references: [id_usuario])
}

// ==========================================
// Solicitudes y Logística - CU-08 a CU-20
// ==========================================

model Solicitud {
  id_solicitud       String   @id @default(uuid())
  fecha_creacion     DateTime @default(now())
  estado_actual      String
  prioridad          String
  latitud_destino    Float
  longitud_destino   Float
  id_solicitante     String
  id_admin           String? // Nullable porque se asigna al aprobar (CU-09)
  id_base            String? // Nullable porque se asigna al aprobar (CU-09)
  motivo_cancelacion String?
  motivo_anulacion   String?

  solicitante Solicitante    @relation(fields: [id_solicitante], references: [id_solicitante])
  admin       Administrador? @relation(fields: [id_admin], references: [id_admin])
  base        Base?          @relation(fields: [id_base], references: [id_base])

  detalles       Detalle_Solicitud[]
  historiales    Historial_Estado[]
  notificaciones Notificacion[]
  envios         Envio[]
}

model Detalle_Solicitud {
  id_detalle      String @id @default(uuid())
  id_solicitud    String
  id_producto     String
  cantidad_pedida Int

  solicitud Solicitud @relation(fields: [id_solicitud], references: [id_solicitud], onDelete: Cascade)
  producto  Producto  @relation(fields: [id_producto], references: [id_producto])
}

model Historial_Estado {
  id_historial    String   @id @default(uuid())
  fecha_hora      DateTime @default(now())
  estado_anterior String?
  estado_nuevo    String
  id_solicitud    String
  id_usuario      String

  solicitud Solicitud @relation(fields: [id_solicitud], references: [id_solicitud], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [id_usuario], references: [id_usuario])
}

model Notificacion {
  id_notificacion    String   @id @default(uuid())
  mensaje            String
  leida              Boolean  @default(false)
  fecha_hora         DateTime @default(now())
  id_solicitud       String?
  id_usuario_destino String

  solicitud       Solicitud? @relation(fields: [id_solicitud], references: [id_solicitud], onDelete: Cascade)
  usuario_destino Usuario    @relation(fields: [id_usuario_destino], references: [id_usuario], onDelete: Cascade)
}

// ==========================================
// Entregas Físicas (ADR-007)
// ==========================================

model Envio {
  id_envio     String @id @default(uuid())
  id_solicitud String
  id_base      String

  matricula_avion String?
  piloto          String?

  latitud_calculada  Float?
  longitud_calculada Float?
  altitud            Float?
  datos_clima        Json?

  estado_envio       String    @default("programado")
  codigo_seguimiento String?
  fecha_hora         DateTime?
  fecha_salida       DateTime?
  entrega_real       DateTime?

  solicitud    Solicitud    @relation(fields: [id_solicitud], references: [id_solicitud])
  base         Base         @relation(fields: [id_base], references: [id_base])
  contenedores Contenedor[]
}

model Contenedor {
  id_contenedor   String @id @default(uuid())
  tipo_paracaidas String
  peso_maximo     Float
  estado_mecanico String
  id_envio        String

  envio Envio @relation(fields: [id_envio], references: [id_envio], onDelete: Cascade)
}
