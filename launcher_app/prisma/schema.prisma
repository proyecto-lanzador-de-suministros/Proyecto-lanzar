generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id_usuario            String                @id @default(uuid())
  administradorId_admin String?
  contrasena            String?
  estado_cuenta         String                @default("PENDIENTE")
  AdministradorUsuario  AdministradorUsuario?
  historiales_estado    Historial_Estado[]
  historiales_stock     Historial_Stock[]
  notificaciones        Notificacion[]
  remitente             Remitente?
  solicitante           Solicitante?
  Administrador         Administrador?        @relation(fields: [administradorId_admin], references: [id_admin])
}

model Solicitante {
  id_solicitante String      @id
  nombre         String
  contacto       String
  usuario        Usuario     @relation(fields: [id_solicitante], references: [id_usuario], onDelete: Cascade)
  solicitudes    Solicitud[]
}

model Administrador {
  id_admin       String               @id
  nombre         String
  permisos_rol   String
  usuario        String
  cuenta_usuario AdministradorUsuario @relation(fields: [id_admin], references: [id_usuario], onDelete: Cascade)
  solicitudes    Solicitud[]
  Usuario        Usuario[]
}

model Remitente {
  id_remitente    String            @id
  nombre_base     String
  latitud_base    Float
  longitud_base   Float
  capacidad_pista String
  Historial_Stock Historial_Stock[]
  Lanzamiento     Lanzamiento[]
  usuario         Usuario           @relation(fields: [id_remitente], references: [id_usuario], onDelete: Cascade)
  Solicitud       Solicitud[]
  Stock_Base      Stock_Base[]
  Vuelo           Vuelo[]
}

model Producto {
  id_producto        String              @id @default(uuid())
  nombre             String
  descripcion        String?
  peso_unitario      Float
  id_tipo            String
  detalles_solicitud Detalle_Solicitud[]
  historiales_stock  Historial_Stock[]
  Tipo               Tipo                @relation(fields: [id_tipo], references: [id_tipo])
  stocks             Stock_Base[]
}

model Stock_Base {
  id_stock            String    @id @default(uuid())
  id_remitente        String
  id_producto         String
  cantidad_disponible Int
  producto            Producto  @relation(fields: [id_producto], references: [id_producto])
  Remitente           Remitente @relation(fields: [id_remitente], references: [id_remitente])
}

model Historial_Stock {
  id_historial_stock String    @id @default(uuid())
  id_remitente       String
  id_producto        String
  cantidad_anterior  Int
  cantidad_nueva     Int
  fecha_hora         DateTime  @default(now())
  id_actor           String
  actor              Usuario   @relation(fields: [id_actor], references: [id_usuario])
  producto           Producto  @relation(fields: [id_producto], references: [id_producto])
  Remitente          Remitente @relation(fields: [id_remitente], references: [id_remitente])
}

model Solicitud {
  id_solicitud       String              @id @default(uuid())
  fecha_creacion     DateTime            @default(now())
  estado_actual      String
  prioridad          String
  latitud_destino    Float
  longitud_destino   Float
  id_solicitante     String
  id_admin           String?
  id_remitente       String?
  motivo_anulacion   String?
  motivo_cancelacion String?
  detalles           Detalle_Solicitud[]
  historiales        Historial_Estado[]
  Lanzamiento        Lanzamiento[]
  notificaciones     Notificacion[]
  admin              Administrador?      @relation(fields: [id_admin], references: [id_admin])
  Remitente          Remitente?          @relation(fields: [id_remitente], references: [id_remitente])
  solicitante        Solicitante         @relation(fields: [id_solicitante], references: [id_solicitante])
}

model Detalle_Solicitud {
  id_detalle      String    @id @default(uuid())
  id_solicitud    String
  id_producto     String
  cantidad_pedida Int
  producto        Producto  @relation(fields: [id_producto], references: [id_producto])
  solicitud       Solicitud @relation(fields: [id_solicitud], references: [id_solicitud], onDelete: Cascade)
}

model Historial_Estado {
  id_historial    String    @id @default(uuid())
  fecha_hora      DateTime  @default(now())
  estado_anterior String?
  estado_nuevo    String
  id_solicitud    String
  id_usuario      String
  solicitud       Solicitud @relation(fields: [id_solicitud], references: [id_solicitud], onDelete: Cascade)
  usuario         Usuario   @relation(fields: [id_usuario], references: [id_usuario])
}

model Notificacion {
  id_notificacion    String     @id @default(uuid())
  mensaje            String
  fecha_hora         DateTime   @default(now())
  id_solicitud       String?
  id_usuario_destino String
  solicitud          Solicitud? @relation(fields: [id_solicitud], references: [id_solicitud], onDelete: Cascade)
  usuario_destino    Usuario    @relation(fields: [id_usuario_destino], references: [id_usuario], onDelete: Cascade)
}

model Contenedor {
  id_contenedor   String      @id @default(uuid())
  tipo_paracaidas String
  peso_maximo     Float
  estado_mecanico String
  id_lanzamiento  String
  Lanzamiento     Lanzamiento @relation(fields: [id_lanzamiento], references: [id_lanzamiento], onDelete: Cascade)
}

model AdministradorUsuario {
  id_usuario    String         @id
  administrador Administrador?
  Usuario       Usuario        @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
}

model Lanzamiento {
  id_lanzamiento     String       @id
  latitud_calculada  Float
  longitud_calculada Float
  altitud            Float
  datos_clima_api    Json
  id_vuelo           String
  id_solicitud       String
  id_remitente       String
  Contenedor         Contenedor[]
  Remitente          Remitente    @relation(fields: [id_remitente], references: [id_remitente])
  Solicitud          Solicitud    @relation(fields: [id_solicitud], references: [id_solicitud])
  Vuelo              Vuelo        @relation(fields: [id_vuelo], references: [id_vuelo])
}

model Tipo {
  id_tipo          String     @id
  nombre_categoria String
  peso_prioridad   Int
  Producto         Producto[]
}

model Vuelo {
  id_vuelo             String        @id
  matricula_avion      String
  piloto               String
  combustible_estimado Float
  id_remitente         String
  Lanzamiento          Lanzamiento[]
  Remitente            Remitente     @relation(fields: [id_remitente], references: [id_remitente])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}
